{
  "name": "tradecloseout",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @tradecloseout/api start:dev",
    "dev:web": "pnpm --filter @tradecloseout/web dev",
    "dev:worker": "pnpm --filter @tradecloseout/worker dev",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "lint": "turbo run lint",
    "test": "pnpm --filter @tradecloseout/shared build && pnpm --filter @tradecloseout/db build && pnpm --filter @tradecloseout/pdf-engine build && pnpm -r --workspace-concurrency=1 run test",
    "test:security": "pnpm --filter @tradecloseout/api exec jest --runInBand test/rls-and-integrity.spec.ts test/rls-isolation.spec.ts test/security-invariants.e2e-spec.ts",
    "db:migrate": "pnpm --filter @tradecloseout/db migrate",
    "db:seed": "pnpm --filter @tradecloseout/db seed",
    "db:seed:vayuputra": "tsx packages/db/src/seed-vayuputra-story.ts",
    "test:rls": "pnpm --filter @tradecloseout/api test:rls",
    "test:rbac": "pnpm --filter @tradecloseout/api test:rbac",
    "test:smoke": "ts-node scripts/test-e2e-smoke.ts",
    "verify:traceability": "ts-node scripts/verify-traceability.ts",
    "test:e2e": "pnpm --filter @tradecloseout/web test:e2e",
    "test:unit": "pnpm --filter @tradecloseout/shared test",
    "test:api": "pnpm --filter @tradecloseout/api test",
    "test:integration": "pnpm --filter @tradecloseout/db test && pnpm --filter @tradecloseout/worker test",
    "test:artifacts": "pnpm --filter @tradecloseout/pdf-engine test",
    "test:browser": "pnpm --filter @tradecloseout/web test"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "fast-glob": "^3.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fontkit": "^2.0.4"
  }
}
