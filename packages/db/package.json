{
  "name": "@tradecloseout/db",
  "version": "0.2.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tenant-tx": {
      "types": "./dist/tenant-tx.d.ts",
      "default": "./dist/tenant-tx.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "migrate": "tsx ./src/run-migrations.ts",
    "seed": "tsx ../../apps/api/scripts/seed-portfolio.ts",
    "seed:vayuputra": "tsx ./src/seed-vayuputra-story.ts",
    "test": "node --import tsx --test test/db-integration.spec.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.3",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "typescript": "^5.8.2"
  }
}
